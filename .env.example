# 大模型服务商：zhipu（默认，glm-4.7-flash 免费档）/ deepseek
# 不填这一行也能用：程序会自动挑「已经填了 Key 的那一家」。
LLM_PROVIDER=zhipu

# 智谱开放平台 https://open.bigmodel.cn 注册后，到「API Keys」页新建一个
ZHIPU_API_KEY=your_api_key_here

# 想换型号（不同账号能用的型号不一样）：取消注释即可，不用改代码
# LLM_MODEL=glm-4.5-flash

# DeepSeek（备选，按量计费）：取消注释并填 Key 即可切过去
# DEEPSEEK_API_KEY=your_api_key_here
