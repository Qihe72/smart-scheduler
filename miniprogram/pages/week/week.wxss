/* pages/week/week.wxss —— 课表周视图样式（无第三方 UI 库，全部手写） */

page {
  background: #f2f4f8;
  font-size: 26rpx;
  color: #1f2430;
}

.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

/* --------------------------------------------------------------------------
   一、顶部周切换
   -------------------------------------------------------------------------- */
.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx 12rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6e9f0;
}

.nav-btn {
  flex: none;
  padding: 12rpx 16rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #2f5bd7;
  background: #eef2fe;
  border-radius: 10rpx;
}

.nav-btn:last-child {
  margin-right: 0;
}

.nav-btn-hover {
  background: #dde6fd;
}

.title-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 8rpx;
}

.title-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.title-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a90a2;
}

/* 非致命提示（未设置开学日期等） */
.hint {
  margin: 12rpx 16rpx 0;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #8a5a00;
  background: #fff7e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 10rpx;
}

/* 加载 / 失败态 */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.state-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a90a2;
  text-align: center;
}

/* --------------------------------------------------------------------------
   二、课表主体
   -------------------------------------------------------------------------- */
.board-scroll {
  /* 减掉顶部工具栏的大致高度，让课表自己滚 */
  height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.board-hscroll {
  width: 100%;
  white-space: nowrap;
}

.board {
  display: inline-block;
  min-width: 100%;
  padding: 0 12rpx 12rpx;
  box-sizing: border-box;
}

/* --------------------------------------------------------------------------
   横向可滑动：列宽怎么定的
   --------------------------------------------------------------------------
   屏幕按 750rpx 算，固定占掉的宽度：
     节次列 122rpx + 表格左右内边距 24rpx = 146rpx
   剩余 750 − 146 = 604rpx 用来放"天"。
     每天 280rpx → 604 / 280 ≈ 2.16 天，加上节次列本身，
     也就是**一屏能看到「节次列 + 约 2 天」，滑动后一天约占屏幕 37%**
     （7 天 × 280 = 1960rpx 的总宽，约为屏幕的 2.6 倍）。
   为什么选 280 而不是更窄：卡片要放得下「程」字徽标 + 至少 4 个汉字。
   卡片宽 ≈ (280 − 12 内边距 − 1 边框) × 48% ≈ 128rpx，减去自身左右内边距 16rpx = 112rpx 可用；
   徽标 22rpx + 间距 4rpx = 26rpx，标题还剩 86rpx；标题 22rpx/字 → 86 / 22 ≈ 3.9 个字
   （汉字实际渲染宽度略小于字号，实际能显示 4 个字出头）。
   再窄就要吃省略号了；徽标也同步从 28rpx 缩到 22rpx 给标题腾地方。
   -------------------------------------------------------------------------- */

.board-row {
  display: flex;
  align-items: stretch;
  /* 【与 week.js 的 ROW_HEIGHT_RPX 必须一致】连堂卡片的高度 = 跨的节数 × 这个行高 − 间隙，
     两处对不上就会出现"卡片短一截 / 压住下一行"。测试里有断言把两者对起来。 */
  height: 96rpx;
  border-bottom: 1rpx solid #e9ecf3;
  box-sizing: border-box;
}

/* 节次栏（左列，表头与数据行共用）。
   width 必须是**定值**：横向滚动靠的就是"内容比屏幕宽"，
   这里一旦改成 flex 弹性宽度，列就会被压回屏幕宽度，滚动也就没了。 */
.period-col {
  flex: none;
  width: 122rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  /* 竖向 padding 只留 4rpx：一行 96rpx 里要放下"节次名 + 上下课时间"两行文字，
     padding 太大会把时间那行裁掉（以后改行高，记得回来核对这一条）。 */
  padding: 4rpx 8rpx 4rpx 4rpx;
  background: #ffffff;
  box-sizing: border-box;
}

/* 横向滑动时把节次列钉在最左边（否则滑到后面不知道自己在第几节）。
   sticky 的参照物是最近的滚动祖先，也就是外层那个 scroll-view。 */
.sticky-col {
  position: sticky;
  left: 0;
  z-index: 2;
}

.period-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2430;
  line-height: 1.25;
  word-break: break-all;
}

.period-time {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a90a2;
  line-height: 1.2;
}

/* 日期列：**定宽** 280rpx（不是 flex: 1），这样 7 天加起来远宽于屏幕 → 能横向滑 */
.day-col {
  flex: none;
  width: 280rpx;
  display: flex;
  flex-wrap: wrap;          /* 同格多条任务竖着排（卡片各占 100% 宽） */
  align-content: flex-start;
  /* 【竖向 padding 必须是 0】卡片的 top/height 是按"行高 × 跨的节数"算的，
     这里一旦有竖向 padding，卡片就会整体下移、和行对不上。
     左右 padding 保留，用来和相邻一天的格子留出缝隙。 */
  padding: 0 6rpx;
  background: #ffffff;
  border-left: 1rpx solid #eef1f6;
  box-sizing: border-box;
  /* 卡片用 position: relative + top 偏移，参照物是它自己原来的位置；
     这里留 relative 是为了同格内多张卡片的层级（z-index）有个明确的上下文 */
  position: relative;
}

/* 今天那一列高亮 */
.today {
  background: #f5f8ff;
}

/* 表头行：竖向吸顶（sticky top）+ 横向最高层级。
   它的第一个格子同时是 .sticky-col（横向吸左），两层 sticky 一起用：
   左上角那个格子因此是"横竖都钉住"的。 */
.header-row {
  position: sticky;
  top: 0;
  z-index: 3;
  border-bottom: 1rpx solid #dfe4ee;
}

/* 左上角（节次表头）要压在其它吸顶格子之上，否则横向滑动时会被日期格盖住 */
.header-row .sticky-col {
  z-index: 4;
}

.header-corner {
  justify-content: center;
  align-items: center;
}

.corner-text {
  font-size: 22rpx;
  color: #8a90a2;
}

.header-day {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 4rpx;
}

.day-weekday {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2430;
}

.day-date {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #8a90a2;
}

.day-free {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #2f8f5b;
  background: #eaf7f0;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.header-day.today .day-weekday {
  color: #2f5bd7;
}

.header-day.today .day-date {
  color: #2f5bd7;
}

/* 午休 / 休息空档行：单独一行、灰底斜纹，行内不出现"空闲"字样 */
.break-row .period-col {
  background: #f6f7fa;
}

.break-row .period-name {
  font-size: 22rpx;
  color: #97a0b5;
  font-weight: 500;
}

.break-row .day-col {
  background: #fafbfd;
}

.break-row .today {
  background: #f3f6fd;
}

/* --------------------------------------------------------------------------
   三、任务条目（同一行同一天多条任务）
   --------------------------------------------------------------------------
   【为什么卡片要用 position: relative + inline 的 top/height】
   连堂的卡片要"占满它跨越的行"，而它只画在**起始行**那一格里（既有设计：
   同一件事不重复画）。普通流式布局下，卡片会被那一格的高度限制住（96rpx），
   撑不出 3 行高；所以给它一个由 JS 算出来的 height，并靠 z-index 盖住后面几行。

   选 relative 而不是 absolute 是有意的：
     * relative 的卡片**仍然在文档流里**，width/margin 照旧生效；
       即便 inline 样式在某个基础库上不生效，它也只是退回"一格高"，
       不会出现"卡片全叠在左上角"这种灾难性降级；
     * 绝对定位那张方案一旦出问题，整个格子会看起来是空的。
   代价是跨行卡片不占流的高度（同格后续卡片会与它重叠）—— 数据里
   "跨节卡 + 同格还有别的课"本身是反常的，重叠比布局崩掉可接受。
   -------------------------------------------------------------------------- */
.chip {
  position: relative;
  width: 100%;
  margin-bottom: 8rpx;
  padding: 8rpx;
  background: #eef2fe;
  border-left: 6rpx solid #2f5bd7;
  border-radius: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 跨多节的卡片：抬高层级 + 一层浅阴影，视觉上"压在"它跨过的那几行上面。
   height / top / z-index 由 week.js 的 blockStyle 给。 */
.chip-block {
  box-shadow: 0 2rpx 10rpx rgba(47, 91, 215, 0.18);
}

.chip-hover {
  opacity: 0.7;
}

.chip-ddl {
  background: #fff1ef;
  border-left-color: #e0553f;
}

.chip-high {
  box-shadow: 0 0 0 1rpx #f0b429 inset;
}

.chip-done {
  opacity: 0.5;
}

.chip-top {
  display: flex;
  align-items: center;
}

/* 类型徽标（程 / 止 / 务）。
   列宽 280rpx 之后卡片宽约 128rpx，原来 28rpx + 6rpx 间距的徽标要吃掉 34rpx（约四分之一，
   窄屏上更明显）。这里缩到 22rpx + 4rpx 间距，只留 26rpx，
   腾出来的宽度留给课程名 —— 徽标只是"这是日程/截止"的辅助色块，标题才是要读的内容。 */
.chip-mark {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
  font-size: 16rpx;
  line-height: 22rpx;
  text-align: center;
  color: #ffffff;
  background: #2f5bd7;
  border-radius: 5rpx;
}

.chip-ddl .chip-mark {
  background: #e0553f;
}

.chip-title {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #1f2430;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chip-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #6b7288;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* --------------------------------------------------------------------------
   四、底部
   -------------------------------------------------------------------------- */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx 40rpx;
}

.add-btn {
  padding: 18rpx 56rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #2f5bd7;
  border-radius: 44rpx;
}

.add-btn-hover {
  background: #2449b3;
}

.footer-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa1b2;
}
