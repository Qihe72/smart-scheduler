<!--
  pages/ai/ai.wxml —— AI 录入 / 拆解页。

  结构：
    ① 顶部两个模式切换（录入 / 拆解）
    ② 录入模式：输入框 + 「解析」→ 结果卡片（可勾选）+ 「确认添加」
    ③ 拆解模式：选一条任务 + 「拆解」→ 子任务清单（可勾选）+ 「确认添加子任务」
    ④ 提示条：绿色是成功、黄色是警告；AI 的失败文案原样显示（后端写好的那句）
-->
<view class="page ai-page">

  <!-- ① 模式切换 -->
  <view class="mode-switch">
    <view class="mode-item {{mode === 'parse' ? 'is-active' : ''}}" bindtap="switchToParse">AI 录入</view>
    <view class="mode-item {{mode === 'decompose' ? 'is-active' : ''}}" bindtap="switchToDecompose">任务拆解</view>
  </view>

  <!-- 提示条（成功 / 警告都走这里） -->
  <view wx:if="{{tip}}" class="tip tip-{{tipType}}">{{tip}}</view>
  <!-- 作息校准是**独立**的一件事：它失败不代表识别/导入失败，所以单独一行、单独口径 -->
  <view wx:if="{{periodsSaveText}}" class="tip tip-muted">{{periodsSaveText}}</view>

  <!-- ===================== ② 录入模式 ===================== -->
  <block wx:if="{{mode === 'parse'}}">
    <view class="card">
      <view class="card-title">说一句话，我来排</view>
      <textarea
        class="ai-textarea"
        value="{{inputText}}"
        bindinput="onInput"
        maxlength="500"
        placeholder="例如：明天下午三点开组会，周五前交实验报告"
        placeholder-class="form-placeholder"
        auto-height
      />
      <view class="muted mt-8">支持一句话里有多件事；没写时间的会问你一句。最多 500 字。</view>
      <view class="row mt-16">
        <view class="btn-ghost btn-mini" bindtap="onClearInput">清空</view>
        <view class="btn-primary btn-mini {{parsing ? 'btn-disabled' : ''}}" bindtap="onParse">
          {{parsing ? '解析中…' : '解析'}}
        </view>
      </view>
    </view>

    <!-- 课表截图识别：用用户自己填的 Key + 多模态模型直接认课表 -->
    <view class="card">
      <view class="row">
        <view class="card-title">课表截图识别</view>
        <text wx:if="{{aiModel}}" class="tag tag-gray tag-line">{{aiModel}}</text>
      </view>
      <view class="muted">拍一张课表（教务系统截图或纸质课表照片），让 AI 认成课程。图片只在识别时用一次，不会保存。</view>

      <!-- 模型提示行：**选图之前**就显示，能识图 / 明确不能 / 不确定 三种口径 -->
      <view wx:if="{{visionHint}}" class="vision-hint vision-hint-{{visionHintLevel}}">{{visionHint}}</view>

      <view wx:if="{{!visionReady}}" class="vision-hint vision-hint-danger">
        当前版本的截图识别不可用，请改用文字录入。
      </view>

      <view class="row mt-16">
        <view class="btn-ghost btn-mini" bindtap="onPickImage" data-source="camera">拍照</view>
        <view class="btn-ghost btn-mini" bindtap="onPickImage" data-source="album">从相册选</view>
      </view>

      <!-- 选好之后的缩略图 + 体积（压到多少要如实说） -->
      <view wx:if="{{imagePath}}" class="vision-preview mt-16">
        <image class="vision-thumb" src="{{imagePath}}" mode="aspectFit" />
        <view class="flex-1">
          <view class="muted">{{imageSource}}的课表图片</view>
          <view class="muted">{{imageSizeText}}</view>
        </view>
      </view>
      <view wx:if="{{imageError}}" class="vision-hint vision-hint-danger">{{imageError}}</view>

      <view class="mt-16">
        <view
          class="btn-primary btn-block {{visionBusy || !imagePath || !visionReady ? 'btn-disabled' : ''}}"
          bindtap="onRecognize"
        >{{visionBusy ? '识别中… 已等待 ' + visionElapsed + ' 秒' : '开始识别'}}</view>
      </view>
      <view wx:if="{{visionBusy}}" class="muted mt-8">正在识别课表，约 10~30 秒… 请不要退出这一页。</view>
    </view>

    <!-- 识别失败：原样显示后端那句可操作的人话（换模型 / 换小图 / 稍后重试） -->
    <view wx:if="{{visionError}}" class="card ai-error">
      <view class="ai-error-title">没能识别</view>
      <view class="ai-error-text">{{visionError}}</view>
    </view>

    <!-- 识别提示：模型自己说"哪里没看清" + 云端跳过的脏条目（课程落库后也留着） -->
    <view wx:if="{{visionWarnings.length}}" class="card ai-notes">
      <view class="card-title">识别提示</view>
      <view wx:for="{{visionWarnings}}" wx:key="index" class="ai-note-item">· {{item}}</view>
      <view wx:if="{{visionNotes}}" class="muted mt-8">{{visionNotes}}</view>
    </view>

    <!-- 解析失败：原样显示后端文案 -->
    <view wx:if="{{parseError}}" class="card ai-error">
      <view class="ai-error-title">没能解析</view>
      <view class="ai-error-text">{{parseError}}</view>
    </view>

    <!-- 反问（模型觉得信息不够） -->
    <view wx:if="{{needClarification && clarification}}" class="card ai-ask">
      <view class="ai-error-title">还需要一点信息</view>
      <view class="ai-error-text">{{clarification}}</view>
    </view>

    <!-- 解析 / 识别结果（两条路共用同一套勾选列表） -->
    <view wx:if="{{parsed}}" class="card">
      <view class="row">
        <view class="card-title">{{parsedSource === 'image' ? '识别出' : '解析出'}} {{parsed.items.length}} 条</view>
        <view class="btn-ghost btn-mini" bindtap="onToggleAll">全选 / 全不选</view>
      </view>

      <view wx:if="{{!parsed.hasAny}}" class="empty">这次没有解析出可添加的日程</view>

      <view
        wx:for="{{parsed.items}}"
        wx:key="index"
        class="ai-item {{item.selected ? 'is-on' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleItem"
      >
        <view class="ai-check">{{item.selected ? '✓' : ''}}</view>
        <view class="flex-1">
          <view class="row">
            <text class="title ellipsis flex-1">{{item.title}}</text>
            <text class="tag {{item.tagClass}} tag-line">{{item.priorityLabel}}</text>
          </view>
          <view class="muted">
            <text wx:if="{{item.courseText}}">{{item.courseText}}</text>
            <text wx:else>{{item.typeLabel}} · {{item.date}}</text>
            <text> · {{item.timeText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{parsed.hasAny}}" class="mt-16">
        <!-- 识图那条路：两个出口 —— 替换课表（会删旧课）/ 追加导入 -->
        <block wx:if="{{parsedSource === 'image'}}">
          <view
            class="btn-primary btn-block {{submitting ? 'btn-disabled' : ''}}"
            bindtap="onVisionAppend"
          >{{submitting ? '处理中…' : '追加导入'}}</view>
          <view
            class="btn-ghost btn-block btn-danger mt-16 {{submitting ? 'btn-disabled' : ''}}"
            bindtap="onVisionReplace"
          >{{submitting ? '处理中…' : '替换课表'}}</view>
          <view class="muted mt-8">
            「替换课表」会先删除现有的课表类任务（只删课程，你手动添加的日程、截止、子任务不受影响）。
          </view>
        </block>
        <!-- 文字解析那条路：维持原来的单按钮 -->
        <block wx:else>
          <view
            class="btn-primary btn-block {{submitting ? 'btn-disabled' : ''}}"
            bindtap="onConfirmImport"
          >{{submitting ? '添加中…' : '确认添加'}}</view>
        </block>
      </view>
    </view>
  </block>

  <!-- ===================== ③ 拆解模式 ===================== -->
  <block wx:if="{{mode === 'decompose'}}">
    <view class="card">
      <view class="row">
        <view class="card-title">选一条任务来拆</view>
        <view class="btn-ghost btn-mini" bindtap="loadCourses">刷新</view>
      </view>

      <view wx:if="{{picking}}" class="muted">读取任务中…</view>
      <view wx:elif="{{!courses.length}}" class="empty">
        还没有可以拆解的任务（需要有日期的未完成任务）
      </view>

      <view
        wx:for="{{courses}}"
        wx:key="_id"
        class="ai-item {{pickedId === item._id ? 'is-on' : ''}}"
        data-id="{{item._id}}"
        bindtap="onPickCourse"
      >
        <view class="ai-check">{{pickedId === item._id ? '✓' : ''}}</view>
        <view class="flex-1">
          <view class="row">
            <text class="title ellipsis flex-1">{{item.title}}</text>
            <text class="tag tag-line">{{item.priorityLabel}}</text>
          </view>
          <view class="muted">{{item.date}}<text wx:if="{{item.repeatLabel}}"> · {{item.repeatLabel}}</text></view>
        </view>
      </view>

      <view class="mt-16">
        <view
          class="btn-primary btn-block {{decomposing || !pickedId ? 'btn-disabled' : ''}}"
          bindtap="onDecompose"
        >{{decomposing ? '拆解中…' : '拆解这一步'}}</view>
      </view>
      <view wx:if="{{pickedTitle}}" class="muted mt-8">当前选中：{{pickedTitle}}（截止 {{pickedDate}}）</view>
    </view>

    <!-- 拆解失败 -->
    <view wx:if="{{decomposeError}}" class="card ai-error">
      <view class="ai-error-title">没能拆解</view>
      <view class="ai-error-text">{{decomposeError}}</view>
    </view>

    <!-- 子任务清单 -->
    <view wx:if="{{subtasks.length}}" class="card">
      <view class="card-title">拆出 {{subtasks.length}} 步</view>
      <view
        wx:for="{{subtasks}}"
        wx:key="index"
        class="ai-item {{item.selected ? 'is-on' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleSubtask"
      >
        <view class="ai-check">{{item.selected ? '✓' : ''}}</view>
        <view class="flex-1">
          <view class="title ellipsis">{{item.title}}</view>
          <view class="muted">{{item.suggested_date}} · 预计 {{item.estimateText}}</view>
        </view>
      </view>
      <view class="mt-16">
        <view
          class="btn-primary btn-block {{submitting ? 'btn-disabled' : ''}}"
          bindtap="onConfirmSubtasks"
        >{{submitting ? '添加中…' : '确认添加子任务'}}</view>
      </view>
    </view>
  </block>

  <view class="footer-hold"></view>
</view>
