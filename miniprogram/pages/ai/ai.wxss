/**
 * pages/ai/ai.wxss —— AI 录入 / 拆解页的私有样式。
 * 通用卡片、按钮、标签都在 app.wxss 里，这里只放这一页特有的部分。
 */

.ai-page {
  padding-bottom: 40rpx;
}

/* 顶部模式切换：两个等宽的分段按钮 */
.mode-switch {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.05);
}

.mode-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  line-height: 72rpx;
  color: #6B7280;
  border-radius: 12rpx;
}

.mode-item.is-active {
  background-color: #4F7FFF;
  color: #FFFFFF;
  font-weight: 500;
}

/* 输入框 */
.ai-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx;
  background-color: #F7F9FC;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1F2430;
}

/* 可勾选的条目（解析结果 / 任务 / 子任务共用） */
.ai-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #EEF1F5;
}

.ai-item:last-child {
  border-bottom: none;
}

.ai-item.is-on {
  background-color: #F7F9FF;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

/* 勾选框 */
.ai-check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 3rpx solid #C9D3E4;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.ai-item.is-on .ai-check {
  background-color: #4F7FFF;
  border-color: #4F7FFF;
  line-height: 34rpx;
}

/* 错误卡片：左边一条红竖条，文案原样显示 */
.ai-error {
  border-left: 8rpx solid #F26D6D;
}

.ai-error-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F26D6D;
  margin-bottom: 8rpx;
}

.ai-error-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
}

/* 反问卡片：主色竖条 */
.ai-ask {
  border-left: 8rpx solid #4F7FFF;
}

.ai-ask .ai-error-title {
  color: #4F7FFF;
}

/* 顶部提示条 */
.tip {
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.tip-ok {
  background-color: #EAF7EF;
  color: #2FA96B;
}

.tip-warn {
  background-color: #FFF5E6;
  color: #E8963C;
}
