<!--
  pages/me/me.wxml —— 「我的」页：学期设置 / 节次作息 / 导入课表 / 导出备份 / 关于。

  【原则】每一项要么真能用、要么明说"暂不支持"，不放点了没反应的按钮。
    1. 学期设置      → 能改（picker 选日期 + 保存按钮）
    2. 节次作息      → 能改：未校准的节次可以「设定时间」补录，已校准的可以「修改 / 清除」
                       （程序推不出"一节没有课的时间"，所以必须让用户自己补 —— 见卡片里的解释）
    3. 到期提醒      → 能开（弹一次微信订阅授权 → ack +1 次）；平台限制写在卡片正文里
    4. 导入课表      → 能用的完整流程；若解析器不可用则显示"当前版本不可用"并禁用按钮
    5. 导出备份      → 能用的（复制到剪贴板）
    6. 关于 / 数据说明 → 静态文案

  【字段来源】用到字段都在 me.js 的 data 里初始化过：
    loading / errorText /
    semesterStart / datePicker / savingSemester / currentWeekNo / currentWeekText /
    periodRows / periodSourceText / periodOverrideText / periodGapHint /
    periodEditVisible / periodEditIndex / periodEditLabel / periodEditStart /
    periodEditEnd / periodEditError / periodSaving / periodSaveText / periodSaveFailed /
    remindLoading / remindReadFailed / remindReady / remindEnabled / remindQuota /
    remindMaxQuota / remindQuotaText / remindLeadMin / remindLeadIndex /
    remindLeadOptions / remindLeadTexts / remindLeadText / remindReadyReason /
    remindStatusType / remindStatusText / remindConfigError / remindHint /
    remindBusy / remindResultText / remindResultType / remindTestAvailable /
    icsAvailable / icsUnavailableText / importing / submitting / pickedFileName /
    parsedCount / taskCount / warnings / previewItems / previewMore / importResultText /
    exporting / exportTaskCount / exportPreview / exportHint /
    version / cloudFunctionName / appName
    periodRows[i] = { key, number, label, timeText, isBreak, calibrated, uncalibrated, actionText }
    previewItems[i] = { title, dateText, whenText, typeLabel }
-->

<view class="page">

  <!-- ================= 加载 / 失败 ================= -->
  <view class="state-box" wx:if="{{loading}}">
    <text class="state-text">正在读取设置…</text>
  </view>
  <view class="state-box" wx:elif="{{errorText}}">
    <text class="state-text">{{errorText}}</text>
    <text class="state-text">下拉可以重试</text>
  </view>

  <block wx:else>

    <!-- ================= 一、学期设置 ================= -->
    <view class="card">
      <view class="card-title">学期设置</view>
      <view class="card-sub">周次与单双周都按这个日期算，请填开学第一周的周一。</view>

      <view class="row">
        <text class="row-label">开学日期</text>
        <view class="row-right">
          <text class="row-value">{{semesterStart || '未设置'}}</text>
          <picker mode="date" value="{{datePicker}}" bindchange="onDateChange">
            <view class="mini-btn">选择</view>
          </picker>
        </view>
      </view>

      <view class="row">
        <text class="row-label">当前状态</text>
        <text class="row-value-plain">{{currentWeekText}}</text>
      </view>

      <view class="btn-row">
        <view
          class="primary-btn {{savingSemester ? 'btn-disabled' : ''}}"
          hover-class="primary-btn-hover"
          bindtap="onSaveSemester"
        >{{savingSemester ? '保存中…' : '保存开学日期'}}</view>
      </view>
      <view class="note">保存后按这一周的周一重新计算。</view>
    </view>

    <!-- ================= 二、节次作息（可补录） ================= -->
    <view class="card">
      <view class="card-title">节次作息</view>
      <view class="card-sub">{{periodSourceText}}</view>

      <view class="period-list">
        <view
          class="period-item {{item.isBreak ? 'period-break' : ''}} {{item.uncalibrated ? 'period-uncal' : ''}}"
          wx:for="{{periodRows}}"
          wx:for-item="item"
          wx:key="key"
        >
          <text class="period-name">{{item.label}}</text>
          <text class="period-time">{{item.timeText}}</text>

          <!-- 状态：已校准（来自导入识别或手动设定）/ 未校准（显示的是内置默认时间） -->
          <text class="period-tag-cal" wx:if="{{item.calibrated}}">已校准</text>
          <text class="period-tag-uncal" wx:elif="{{item.uncalibrated}}">未校准</text>

          <!-- 未校准的行：主按钮是「设定时间」；已校准的行：可「修改」也可「清除」。
               空档行（row[0] === 'break'，没有节次号）没有按钮 —— 它的时间是从左右两节
               推出来的正确信息，period_times 里也没有它的键，无处可存。 -->
          <view
            class="period-act period-act-main"
            wx:if="{{item.editable}}"
            hover-class="period-act-hover"
            data-index="{{index}}"
            bindtap="onTapPeriodSet"
          >{{item.actionText}}</view>
          <view
            class="period-act period-act-clear"
            wx:if="{{item.editable && item.calibrated}}"
            hover-class="period-act-hover"
            data-index="{{index}}"
            bindtap="onTapPeriodClear"
          >清除</view>
        </view>
      </view>

      <!-- 未校准那几行的解释（说清"为什么显示的不是你课表里的时间"） -->
      <view class="note note-warn" wx:if="{{periodOverrideText}}">{{periodOverrideText}}</view>

      <!-- 改完会看到什么：给用户一个预期（课间 45 分钟以上会显示成「午休」行） -->
      <view class="note">{{periodGapHint}}</view>

      <!-- 作息保存这一路的结果（补录 / 清除 / 导入校准共用；失败也写这里，不弹 toast 打断） -->
      <view
        class="note {{periodSaveFailed ? 'note-warn' : 'note-ok'}}"
        wx:if="{{periodSaveText}}"
      >{{periodSaveText}}</view>
    </view>

    <!-- ============ 二·补录弹层：给某一节设定上下课时间 ============ -->
    <view class="sheet-mask" wx:if="{{periodEditVisible}}" bindtap="onTapPeriodCancel">
      <!-- catchtap 阻止冒泡：点面板本身不该关掉它 -->
      <view class="sheet" catchtap="onNoop">
        <view class="sheet-title">设定「{{periodEditLabel}}」的时间</view>
        <view class="sheet-sub">填这一节实际的上课时间，保存后课表按它对齐。</view>

        <view class="sheet-row">
          <text class="sheet-label">开始</text>
          <picker
            mode="time"
            value="{{periodEditStart}}"
            bindchange="onPeriodStartChange"
          >
            <view class="sheet-picker">{{periodEditStart || '请选择'}}</view>
          </picker>
        </view>

        <view class="sheet-row">
          <text class="sheet-label">结束</text>
          <picker
            mode="time"
            value="{{periodEditEnd}}"
            bindchange="onPeriodEndChange"
          >
            <view class="sheet-picker">{{periodEditEnd || '请选择'}}</view>
          </picker>
        </view>

        <view class="sheet-error" wx:if="{{periodEditError}}">{{periodEditError}}</view>

        <view class="btn-row">
          <view
            class="primary-btn {{periodSaving ? 'btn-disabled' : ''}}"
            hover-class="primary-btn-hover"
            bindtap="onTapPeriodSave"
          >{{periodSaving ? '保存中…' : '保存'}}</view>
          <view class="ghost-btn" hover-class="ghost-btn-hover" bindtap="onTapPeriodCancel">取消</view>
        </view>
      </view>
    </view>

    <!-- ================= 三点五、到期提醒（微信订阅消息） ================= -->
    <!--
      【这一块为什么长这样】微信的订阅消息有两条绕不过去的平台限制，
      必须**在界面上讲清楚**，否则用户会以为功能坏了：
        1. 订阅消息是一次性的 —— 用户授权一次，服务端只能下发一条。
           所以每点一次按钮只 +1 次机会（ack count 恒为 1），要多几条就多点几次。
        2. 模板 ID 只在服务端（云函数环境变量 REMIND_TEMPLATE_ID），前端**不硬编码**：
           换模板只改那一个环境变量，不用重新提审小程序。所以这里一个字都不显示模板 ID，
           只显示"配没配好"这个结论；真没配就用 ready_reason 指向 docs/到期提醒.md。
    -->
    <view class="card">
      <view class="card-title">到期提醒</view>
      <view class="card-sub">截止事项到期前，让微信给你发一条「服务通知」。</view>

      <!-- 状态行：开关 / 剩余次数 / 提前量 -->
      <view class="remind-status remind-status-{{remindStatusType}}" wx:if="{{remindStatusText}}">
        <text class="remind-status-text">{{remindStatusText}}</text>
        <text class="remind-status-quota" wx:if="{{remindQuotaText}}">{{remindQuotaText}}</text>
      </view>
      <view class="remind-status" wx:elif="{{remindLoading}}">
        <text class="remind-status-text">正在读取提醒设置…</text>
      </view>
      <!-- 读失败：只有这一行灰字，**不弹 toast**（用户可能只是想来看学期设置） -->
      <view class="note" wx:if="{{remindHint}}">{{remindHint}}</view>

      <!-- ready=false 时把服务端那句人话原样显示（它已经指明了下一步该做什么） -->
      <view class="note note-warn" wx:if="{{remindReadyReason && !remindReady}}">{{remindReadyReason}}</view>
      <view class="note note-ok" wx:elif="{{remindReady && remindReadyReason}}">{{remindReadyReason}}</view>

      <!-- 提前量：候选档位来自服务端（lead_options），不在前端写死 -->
      <view class="row">
        <text class="row-label">提前量</text>
        <picker
          class="row-right"
          mode="selector"
          range="{{remindLeadTexts}}"
          value="{{remindLeadIndex}}"
          bindchange="onRemindLeadChange"
        >
          <view class="picker-value">
            <text class="picker-value-text">{{remindLeadText || '未设置'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <!-- 【本功能最关键的交互】开启 / 补充授权 -->
      <view class="btn-row">
        <view
          class="primary-btn {{(remindBusy || remindLoading) ? 'btn-disabled' : ''}}"
          hover-class="primary-btn-hover"
          bindtap="onRemindEnable"
        >{{remindConfigError ? '看看该怎么配置' : (remindEnabled ? '补充授权 +1 次' : '开启并授权 +1 次')}}</view>
        <view
          class="ghost-btn {{(!remindTestAvailable || remindBusy || remindLoading) ? 'btn-disabled' : ''}}"
          hover-class="ghost-btn-hover"
          bindtap="onRemindTest"
        >发一条测试提醒</view>
      </view>

      <!-- 平台限制的解释 —— 少了这一行，用户会觉得"怎么又要授权"是 bug -->
      <view class="note">
        <text class="note-strong">一次性订阅：授权一次只能收到一条提醒。</text>
        这是微信的规则：工具类小程序申请不到长期订阅。
      </view>

      <!-- ===================================================================
           三点六、少点几次（三条路，按"省事程度"排）
           1. 一次补齐     —— 点一下连弹到 3 条（每个授权窗仍要各点一次"允许"，那是微信的交互）
           2. 勾选免打扰   —— 用户勾过「总是保持以上选择」后，本页任何一次点击都会静默补 1 次额度
           3. 写系统日历   —— 不消耗微信额度、不限条数、离线也响（真正的"全部放开"）
           =================================================================== -->
      <view class="sub-title">少点几次</view>

      <view class="btn-row">
        <view
          class="primary-btn {{(remindTopUpBusy || remindBusy || remindLoading) ? 'btn-disabled' : ''}}"
          hover-class="primary-btn-hover"
          bindtap="onRemindTopUpRound"
        >{{remindTopUpLabel || '一次补齐 3 次（少点两次）'}}</view>
      </view>
      <view class="note" wx:if="{{remindSilentText}}">{{remindSilentText}}</view>

      <view class="btn-row">
        <view
          class="wide-btn {{remindCalBusy ? 'btn-disabled' : ''}}"
          hover-class="wide-btn-hover"
          bindtap="onAddToCalendar"
        >{{remindCalBusy ? '正在写入…' : '把截止事项写进手机日历'}}</view>
      </view>
      <view class="note">
        <text class="note-strong">这条路不消耗微信提醒次数，也没有条数限制。</text>
        写进手机日历后由系统闹钟提醒，断网也会响。
      </view>
      <view
        class="result-line"
        wx:if="{{remindCalText}}"
      >{{remindCalText}}</view>

      <!-- ===================================================================
           三点七、检查一次（替服务端跑一遍扫描，把"为什么不提醒"说成人话）
           【为什么要这个按钮】真实提醒只有"定时扫描"这一个入口，而它断掉的时候
           界面上一点痕迹都没有（测试按钮绕过扫描，照样能响）。这个按钮把扫描的
           返回值摆到用户眼前：扫到几条、发了没有、跳过是为什么。
           =================================================================== -->
      <view class="btn-row">
        <view
          class="wide-btn {{(remindBusy || remindLoading) ? 'btn-disabled' : ''}}"
          hover-class="wide-btn-hover"
          bindtap="onRemindSelfCheck"
        >检查一次：现在为什么不提醒</view>
      </view>
      <view
        class="result-line {{remindSelfCheckType === 'warn' ? 'result-line-warn' : ''}}"
        wx:if="{{remindSelfCheckText}}"
      >{{remindSelfCheckText}}</view>

      <!-- 结果行：成功 / 失败 / 拒绝 / 未消耗额度，都如实写在这里 -->
      <view
        class="result-line {{remindResultType === 'warn' ? 'result-line-warn' : ''}}"
        wx:if="{{remindResultText}}"
      >{{remindResultText}}</view>
      <view class="note" wx:if="{{remindReadFailed}}">
        需要重试时下拉刷新本页即可。
      </view>

      <view class="note">「发一条测试提醒」不消耗可提醒次数，用来先确认微信能不能收到。</view>
      <view class="note">收不到？先看手机微信的「服务通知」有没有被关掉。</view>
    </view>

    <!-- ================= 四、导入课表 ================= -->
    <view class="card">
      <view class="card-title">导入课表（.ics）</view>

      <!-- 解析器不可用时的明确说明（不假装能用） -->
      <block wx:if="{{!icsAvailable}}">
        <view class="note note-warn">{{icsUnavailableText}}</view>
        <view class="btn-row">
          <view class="primary-btn btn-disabled">导入课表（暂不可用）</view>
        </view>
      </block>

      <block wx:else>
        <view class="card-sub">从微信聊天记录里选一个 .ics 日历文件（先把文件发给自己或文件传输助手即可）。</view>

        <!-- 导入方式：默认「替换」（用户要的就是这个），但要让人看见自己在选什么 -->
        <view class="mode-title">导入方式</view>
        <view class="mode-bar">
          <view
            class="mode-item {{importMode === item.value ? 'mode-on' : ''}} {{(item.value === 'replace' && !importReplaceReady) ? 'mode-disabled' : ''}}"
            wx:for="{{importModes}}"
            wx:for-item="item"
            wx:key="value"
            data-mode="{{item.value}}"
            bindtap="onImportModeChange"
          >{{item.label}}</view>
        </view>
        <view class="note" wx:if="{{importMode === 'replace'}}">
          替换会先清掉 <text class="note-strong">「每周重复 + 有节次」的课程</text>（.ics 导入的那种）；
          手工添加的日程、截止与子任务不删。
        </view>
        <view class="note" wx:else>
          追加是直接加进去；同一门课导两次会出现两份，需要自己删。
        </view>
        <view class="note" wx:if="{{replaceSummary}}">{{replaceSummary}}</view>
        <view class="note note-warn" wx:if="{{importReplaceHint}}">{{importReplaceHint}}</view>

        <view class="btn-row">
          <view
            class="primary-btn {{importing ? 'btn-disabled' : ''}}"
            hover-class="primary-btn-hover"
            bindtap="onPickIcs"
          >{{importing ? '正在解析…' : '选择 .ics 文件'}}</view>
        </view>

        <!-- ================= 从教务系统导入（复制粘贴） ================= -->
        <!--
          【为什么是"复制粘贴"】深大 ehall 的课表页一跳就跳去统一身份认证；小程序又既不能
          请求非自有域名、个人主体也不能用 web-view、云函数更没有用户的 Cookie。
          所以让用户在自己浏览器里登录，把**内容**粘进来 —— 凭据全程不经过我们。
          这一段只在解析器可用时显示（与 .ics 那条路同一套保护）。
        -->
        <block wx:if="{{icsAvailable}}">
          <view class="sub-title">从教务系统导入（不需要密码）</view>
          <view class="btn-row">
            <view
              class="wide-btn {{importing ? 'btn-disabled' : ''}}"
              hover-class="wide-btn-hover"
              bindtap="onImportFromTimetable"
            >{{importing ? '正在解析…' : '从剪贴板导入课表'}}</view>
          </view>
          <view class="note">
            教务系统里<text class="note-strong">先登录</text>，然后二选一：
            ① 课表页按 <text class="note-strong">Ctrl+A、Ctrl+C</text> 复制；
            ② 或按 <text class="note-strong">Ctrl+S</text> 把网页另存成文件、发到微信任意聊天里选文件导入。
            复制好回到这里点上面的按钮即可（学号密码不会被读取，也不会上传）。
          </view>
          <view class="note">
            认不出来时会把没读懂的行列出来，不会静默导入一堆空课程；
            <text class="note-strong">课程名或节次缺了的那几条，可以手动补上</text>。
          </view>
        </block>

        <!-- 解析结果 -->
        <block wx:if="{{pickedFileName}}">
          <view class="row">
            <text class="row-label">文件</text>
            <text class="row-value-plain">{{pickedFileName}}</text>
          </view>
          <view class="result-line" wx:if="{{importResultText}}">{{importResultText}}</view>
          <!-- 从文件里校准出的作息：导入成功后会一并存回 settings -->
          <view class="note" wx:if="{{calibratedText}}">{{calibratedText}}</view>
          <!-- 作息保存这一路的**独立**结果：导入成功文案不受它影响 -->
          <view
            class="note {{periodSaveFailed ? 'note-warn' : 'note-ok'}}"
            wx:if="{{periodSaveText}}"
          >{{periodSaveText}}</view>

          <!-- 警告必须显示，不能吞掉 -->
          <view class="warn-box" wx:if="{{warnings.length}}">
            <text class="warn-title">有 {{warnings.length}} 处没能识别：</text>
            <text class="warn-item" wx:for="{{warnings}}" wx:for-item="w" wx:key="*this">· {{w}}</text>
          </view>

          <!-- 预览 -->
          <block wx:if="{{previewItems.length}}">
            <view class="preview-title">预览（前 {{previewItems.length}} 条）</view>
            <view class="preview-item" wx:for="{{previewItems}}" wx:for-item="p" wx:key="title">
              <text class="preview-tag">{{p.typeLabel}}</text>
              <text class="preview-title-text">{{p.title}}</text>
              <text class="preview-meta">{{p.dateText}}{{p.whenText ? ' · ' : ''}}{{p.whenText}}</text>
            </view>
            <view class="preview-more" wx:if="{{previewMore}}">还有 {{previewMore}} 条未展示…</view>

            <view class="btn-row">
              <view
                class="primary-btn {{submitting ? 'btn-disabled' : ''}}"
                hover-class="primary-btn-hover"
                bindtap="onConfirmImport"
              >{{submitting ? '正在处理…' : (importMode === 'replace' ? '替换导入 ' + taskCount + ' 门' : '追加导入 ' + taskCount + ' 条')}}</view>
              <view class="ghost-btn" hover-class="ghost-btn-hover" bindtap="onCancelImport">取消</view>
            </view>
            <view class="note" wx:if="{{importMode === 'replace'}}">
              点「替换导入」会先弹确认框写清删几门、导几门；确认前可以取消。
            </view>
            <view class="note" wx:else>追加是「新增」，不会覆盖已有任务；一次最多 200 条。</view>
          </block>
        </block>
      </block>
    </view>

    <!-- ================= 五、导出备份 ================= -->
    <view class="card">
      <view class="card-title">导出备份</view>
      <view class="card-sub">把当前全部任务导出成 JSON 文本，复制到剪贴板。</view>
      <view class="btn-row">
        <view
          class="primary-btn {{exporting ? 'btn-disabled' : ''}}"
          hover-class="primary-btn-hover"
          bindtap="onExport"
        >{{exporting ? '正在导出…' : '复制备份到剪贴板'}}</view>
      </view>
      <view class="note" wx:if="{{exportHint}}">{{exportHint}}</view>
      <view class="note">粘贴到备忘录或发给自己即可备份。</view>
      <view class="code-box" wx:if="{{exportPreview}}">{{exportPreview}}…</view>
    </view>

    <!-- ================= 六、关于 ================= -->
    <view class="card">
      <view class="card-title">关于</view>
      <view class="card-sub">{{appName}} · 微信小程序云开发版 · v{{version}}</view>
      <view class="about-line">
        把「课表 + 截止 + 子任务」放在一处的日程管家：左侧按节次排课表，
        任务按 DDL 与优先级管理。
      </view>

      <view class="sub-title">第三方资源与致谢</view>
      <view class="third-item">
        <text class="third-name">微信云开发</text>
        <text class="third-desc">云函数、云数据库与身份识别。</text>
      </view>
      <view class="row">
        <text class="row-label">云函数</text>
        <text class="row-value-plain">{{cloudFunctionName}}</text>
      </view>
      <view class="row">
        <text class="row-label">云环境 ID</text>
        <view class="row-right">
          <text class="row-value-plain">见 app.js</text>
          <view class="mini-btn" bindtap="onCopyEnvId">复制</view>
        </view>
      </view>
    </view>

    <!-- ================= 六点五、联系与反馈 ================= -->
    <!--
      【这一张卡解决什么】用的人要能找到作者：提问题、报 bug、给修改建议。
      三条动作**全是"复制"** —— 小程序里没有 mailto:，也不能直接跳去加好友，
      剪贴板是唯一既可靠又不需要任何权限的方式（与上面「导出备份」同一个理由）。
      显示的值来自 me.js 的 CONTACTS（只有那一份），改号只需改那一处。
    -->
    <view class="card">
      <view class="card-title">联系与反馈</view>
      <view class="card-sub">用着不顺手、发现 bug、想要新功能，都可以直接找我。</view>

      <view class="row">
        <text class="row-label">微信号</text>
        <view class="row-right">
          <text class="row-value-plain">{{contactWechat}}</text>
          <view class="mini-btn" data-kind="wechat" bindtap="onCopyContact">复制</view>
        </view>
      </view>
      <view class="row">
        <text class="row-label">邮箱</text>
        <view class="row-right">
          <text class="row-value-plain">{{contactEmail}}</text>
          <view class="mini-btn" data-kind="email" bindtap="onCopyContact">复制</view>
        </view>
      </view>

      <view class="btn-row">
        <view class="wide-btn" hover-class="wide-btn-hover" bindtap="onCopyFeedbackTemplate">复制反馈模板</view>
      </view>
      <view class="note">
        提问题时带上<text class="note-strong">手机型号、微信版本、点过哪几步</text>会好定位很多 ——
        点上面的按钮会复制一段带这些空位的模板，填完发我就行。
      </view>
      <view class="note">
        想实际体验：小程序现在是<text class="note-strong">体验版</text>，
        微信限制只有「体验成员」能打开 —— 把微信号发我，我加你进名单就行。
      </view>
      <view class="note" wx:if="{{contactResultText}}">{{contactResultText}}</view>
    </view>

    <!-- ================= 七、数据说明 ================= -->
    <view class="card">
      <view class="card-title">你的数据在哪里</view>
      <view class="about-line">
        所有日程都保存在你自己的微信云开发环境里，并按微信 openid 做隔离：
        每条记录的读写都会带上你的 openid 作为条件，别人即使拿到你的任务 id 也读不到、改不了。
        本小程序没有自建服务器，也不会把你的日程发给第三方。
      </view>
      <view class="about-line">
        换手机、重装微信都不会丢数据（它跟着你的微信身份走）；但删掉云开发环境就会一起删掉，
        所以重要数据建议定期用上面的「导出备份」留一份。
      </view>
    </view>

    <view class="footer-tip">{{appName}} · 数据存于你自己的云环境</view>

  </block>

</view>
