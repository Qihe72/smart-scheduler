<!--
  pages/tasks/tasks.wxml —— DDL / 子任务列表。

  【结构】
    顶部：三个筛选标签（进行中 / 即将到期 / 全部 / 已完成）+ 一行统计
    顶部下方：「24 小时内到期」警示条（有符合项时才出现，点它切到「即将到期」筛选）
    中间：任务卡片列表
      左边  勾选框（catchtap，避免连带触发"进入编辑"）
      中间  标题 / 类型 / 日期 / 时间或节次 / 优先级 / 预计耗时 / 重复 /「即将到期」
            子任务多一行「↳ 属于：<父标题>」（点它跳父任务）
      右边  删除按钮（catchtap，弹窗二次确认）
    底部：「加载更多」或「已全部加载」

  【字段来源】都用到的字段都在 tasks.js 的 data 里初始化过：
    filters / taskFilter / filterText / visibleItems / hasMore / emptyText /
    loading / errorText / busyId / totalCount / pendingCount / doneCount / todayCount /
    dueSoonCount / dueSoonText
    visibleItems[i] = { id, title, type, typeLabel, done, priority, priorityLabel,
                        highPriority, dateText, isToday, whenText, location,
                        estimateText, repeatText, parentId, parentTitle,
                        showParent, childCount, subtaskOfOther, isSoon }
-->

<view class="page">

  <!-- 一、统计 + 筛选 -->
  <view class="topbar">
    <view class="stat-line">
      <text class="stat-strong">进行中 {{pendingCount}}</text>
      <text class="stat-sep">·</text>
      <text class="stat-item">已完成 {{doneCount}}</text>
      <text class="stat-sep">·</text>
      <text class="stat-item">共 {{totalCount}}</text>
      <text class="stat-sep">·</text>
      <text class="stat-item">今天 {{todayCount}}</text>
    </view>
    <view class="filter-bar">
      <view
        class="filter-item {{taskFilter === item.key ? 'filter-on' : ''}}"
        wx:for="{{filters}}"
        wx:for-item="item"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTapFilter"
      >{{item.label}}</view>
      <text class="filter-text">{{filterText}}</text>
    </view>

  </view>

  <!--
    一.5、【降级提示】24 小时内到期的截止事项
    —— 这条**不依赖微信订阅消息**（不依赖模板是否配好、用户是否授权、remind 云函数是否可用），
       永远是纯前端拿已拉到的列表现算的。点一下切到「即将到期」筛选，把那几条摆到眼前。
       没有符合项时 dueSoonText 是空串 → 这一条整条不渲染。
  -->
  <view class="soon-banner" wx:if="{{dueSoonText}}" hover-class="soon-banner-hover" bindtap="onTapSoonBanner">
    <text class="soon-icon">⏰</text>
    <text class="soon-text">{{dueSoonText}}</text>
    <text class="soon-action">查看</text>
  </view>

  <!-- 二、加载中 / 加载失败 -->
  <view class="state-box" wx:if="{{loading}}">
    <text class="state-text">正在加载任务…</text>
  </view>
  <view class="state-box" wx:elif="{{errorText}}">
    <text class="state-text">{{errorText}}</text>
    <text class="state-text">下拉可以重试</text>
  </view>

  <!-- 三、空态 -->
  <view class="state-box" wx:elif="{{visibleItems.length === 0}}">
    <text class="state-text">{{emptyText}}</text>
    <view class="add-btn" hover-class="add-btn-hover" bindtap="onTapAdd">添加一条</view>
  </view>

  <!-- 四、列表 -->
  <view class="list" wx:else>
    <view
      class="card {{item.done ? 'card-done' : ''}} {{item.isSoon ? 'card-soon' : ''}}"
      wx:for="{{visibleItems}}"
      wx:for-item="item"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapItem"
      hover-class="card-hover"
    >
      <!-- 勾选框：catchtap 阻断冒泡，点它只完成，不进编辑页 -->
      <view
        class="check {{item.done ? 'check-on' : ''}}"
        data-id="{{item.id}}"
        catchtap="onToggleDone"
      >
        <text class="check-mark" wx:if="{{item.done}}">✓</text>
      </view>

      <view class="card-body">
        <!-- 第一行：标题 + 优先级 -->
        <view class="line-title">
          <text class="c-title {{item.done ? 'c-title-done' : ''}}">{{item.title}}</text>
          <text
            class="priority {{item.highPriority ? 'priority-high' : ''}}"
            wx:if="{{item.priority !== 'mid'}}"
          >{{item.priorityLabel}}</text>
        </view>

        <!-- 第二行：类型 / 日期 / 时间或节次 / 「即将到期」标记 -->
        <view class="line-meta">
          <text class="tag">{{item.typeLabel}}</text>
          <text class="meta {{item.isToday ? 'meta-today' : ''}}">{{item.dateText}}</text>
          <text class="meta" wx:if="{{item.whenText}}">{{item.whenText}}</text>
          <!-- 视觉标记：24 小时内到期且未完成。样式沿用现有标签体系（与优先级同一版式，
               只换配色），不新造一套设计语言 -->
          <text class="meta-soon" wx:if="{{item.isSoon}}">即将到期</text>
          <!-- 「缺时刻」：截止只填了日期、没填具体时刻 —— 微信提醒会直接跳过它。
               这个状态以前完全看不出来（用户以为"设了截止"就一定会有提醒），
               现在至少能在列表里一眼看到，点进去能一键补 23:59 -->
          <text class="meta-soon meta-notime" wx:if="{{item.needsTime}}">缺时刻·不会提醒</text>
        </view>

        <!-- 第三行：预计耗时 / 地点 / 重复（有才显示） -->
        <view class="line-extra" wx:if="{{item.estimateText || item.location || item.repeatText}}">
          <text class="extra extra-est" wx:if="{{item.estimateText}}">{{item.estimateText}}</text>
          <text class="extra" wx:if="{{item.location}}">{{item.location}}</text>
          <text class="extra" wx:if="{{item.repeatText}}">{{item.repeatText}}</text>
        </view>

        <!-- 子任务：显示归属，点小字直接跳父任务 -->
        <view class="line-parent" wx:if="{{item.showParent}}">
          <text
            class="parent-link"
            data-parent-id="{{item.parentId}}"
            catchtap="onTapParent"
          >↳ 属于：{{item.parentTitle}}</text>
        </view>
      </view>

      <!-- 删除按钮：catchtap 阻断冒泡，点它不会同时进编辑页 -->
      <view class="card-actions">
        <view class="del-btn" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </view>

    <!-- 分页 -->
    <view class="more-box" wx:if="{{hasMore}}">
      <view class="more-btn" hover-class="more-btn-hover" bindtap="onLoadMore">加载更多</view>
    </view>
    <view class="more-box" wx:else>
      <text class="more-end">已全部加载</text>
    </view>
  </view>

  <!-- 五、底部新增（列表非空时才显示；空态里已经有一个按钮了） -->
  <view class="footer" wx:if="{{!loading && !errorText && visibleItems.length > 0}}">
    <view class="add-btn" hover-class="add-btn-hover" bindtap="onTapAdd">添加任务</view>
  </view>

</view>
